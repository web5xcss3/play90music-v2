{
    "1987": {
        "description": "A música eletrônica de dança ganha novas formas com a força do synth-pop, do hi-NRG e da house music. Na Europa, clubes e rádios aproximam batidas eletrônicas, melodias marcantes e vocais pop, preparando o terreno para a explosão dos sons dançantes que marcariam a década seguinte."
    },
    "1988": {
        "description": "A house music se espalha pelos clubes europeus e influencia cada vez mais a produção pop. Sintetizadores, sequenciadores e batidas repetitivas ganham espaço, enquanto a cena de clubes cria novas conexões entre Chicago, Nova York, Reino Unido e o continente europeu."
    },
    "1989": {
        "description": "No fim dos anos 1980, a house e o acid house impulsionam uma nova cultura de clubes na Europa. Batidas fortes, linhas de baixo sintéticas e uma energia coletiva ajudam a abrir caminho para o crescimento da dance music nos anos 1990."
    },
    "1990": {
        "description": "A música de dança entra em transformação. House, techno, italo house e sons de inspiração hip-hop convivem nas pistas europeias. Produtores exploram sintetizadores, samples e vocais, criando parte da base sonora que ajudaria a definir a Eurodance nos anos seguintes."
    },
    "1991": {
        "description": "A dance music europeia ganha identidade própria, aproximando melodias pop, rap, vocais femininos e batidas de clubes. A influência da house e do techno continua forte, enquanto produtores desenvolvem fórmulas mais diretas e radiofônicas para conquistar pistas e paradas musicais."
    },
    "1992": {
        "description": "A Eurodance começa a se consolidar como uma das sonoridades mais reconhecíveis da Europa. Batidas aceleradas, refrões marcantes, sintetizadores e a combinação de vocais cantados com partes de rap tornam-se elementos frequentes, levando a música dos clubes para rádios e televisão."
    },
    "1993": {
        "description": "A Eurodance amplia seu alcance internacional. Projetos de produtores, vocalistas e rappers apresentam refrões memoráveis, bases eletrônicas pulsantes e uma estética própria. Alemanha, Itália, Reino Unido e outros mercados europeus tornam-se centros importantes dessa nova onda dançante."
    },
    "1994": {
        "description": "A Eurodance vive um período de grande expansão, com lançamentos que atravessam fronteiras e dominam pistas e rádios. O encontro entre vocais poderosos, rap, sintetizadores e refrões eufóricos define uma sonoridade que se torna símbolo da cultura pop dançante dos anos 1990."
    },
    "1995": {
        "description": "A Eurodance alcança enorme popularidade internacional. Novos projetos surgem, artistas estabelecidos ampliam seu público e a produção combina melodias grandiosas, batidas rápidas, vocais expressivos e elementos de house, techno e pop. É um dos anos centrais da era de ouro do gênero."
    },
    "1996": {
        "description": "A cena Eurodance continua forte, mas diversifica sua fórmula. Sons próximos do euro-house, trance e dance-pop aparecem ao lado das estruturas clássicas do gênero. Grandes refrões e produções eletrônicas seguem presentes nas pistas, rádios e coletâneas."
    },
    "1997": {
        "description": "A música de dança europeia passa por uma transição criativa. Eurodance, euro-house, trance e dream house dividem espaço, enquanto produções mais melódicas e atmosféricas ganham destaque. Remixes e maxi-singles mantêm os clubes como centros de descoberta musical."
    },
    "1998": {
        "description": "O final da década traz forte presença do trance, do euro-house e do dance-pop. A produção eletrônica ganha novas texturas e melodias expansivas, enquanto a Eurodance mantém sua influência em projetos, remixes e sucessos ligados à memória das pistas dos anos 1990."
    },
    "1999": {
        "description": "A virada do milênio aproxima a dance music de novas tendências eletrônicas. Trance, euro-house, house e pop dançante ocupam as pistas, com produções cada vez mais digitais. A sonoridade clássica da Eurodance permanece influente e prepara o caminho para os anos 2000."
    },
    "2000": {
        "description": "A dance music inicia o novo milênio em renovação. Trance, house, vocal trance e dance-pop ganham força, enquanto produtores adotam ferramentas digitais e novas técnicas. A herança da Eurodance continua presente em melodias, vocais e refrões voltados para grandes públicos."
    },
    "2001": {
        "description": "As pistas internacionais recebem uma mistura cada vez maior de trance melódico, house e pop eletrônico. Remixes e versões estendidas seguem importantes para DJs, enquanto a produção digital aproxima a música de clubes das paradas comerciais."
    },
    "2002": {
        "description": "A música eletrônica de dança se diversifica entre trance, euro-house, progressive house e dance-pop. Melodias atmosféricas e vocais marcantes convivem com batidas fortes, e a cultura dos DJs ganha visibilidade em festivais, clubes e lançamentos internacionais."
    },
    "2003": {
        "description": "O cenário eletrônico combina a energia do trance com o crescimento da house e de estilos comerciais. Produções voltadas às pistas circulam por remixes, compilações e clubes, enquanto a internet começa a transformar a maneira como fãs descobrem música."
    },
    "2004": {
        "description": "A dance music segue presente nas rádios e pistas, com destaque para vocal trance, progressive house e pop eletrônico. A produção digital torna os arranjos mais variados, e a cultura de remixes mantém antigas e novas sonoridades em diálogo."
    },
    "2005": {
        "description": "A música eletrônica amplia sua presença global. House, trance e electro aproximam-se de novas tendências pop, enquanto DJs e produtores conquistam maior exposição. A distribuição digital e as comunidades online ganham importância na descoberta musical."
    },
    "2006": {
        "description": "Novas vertentes de electro-house e progressive house ganham espaço, trazendo sintetizadores incisivos e batidas para grandes pistas. Ao mesmo tempo, o trance melódico e a vocal dance continuam atraindo fãs, mostrando a diversidade eletrônica da década."
    },
    "2007": {
        "description": "A música eletrônica torna-se ainda mais visível na cultura popular. Electro-house, house e dance-pop chegam a públicos amplos, enquanto plataformas digitais e redes sociais aceleram a circulação de faixas, remixes e sets. A figura do DJ produtor ganha destaque."
    },
    "2008": {
        "description": "A música eletrônica expande sua presença em festivais e plataformas digitais. House, electro-house e trance seguem em evidência, enquanto produtores exploram timbres mais pesados e formatos pensados para grandes palcos."
    },
    "2009": {
        "description": "O fim dos anos 2000 marca a consolidação de uma dance music global, impulsionada por festivais, downloads e comunidades online. Electro-house, progressive house e trance convivem com o pop eletrônico, ampliando a presença dos DJs e produtores."
    },
    "2010": {
        "description": "A música eletrônica entra em uma década de enorme projeção internacional. Festivais crescem, DJs tornam-se atrações globais e estilos como progressive house, electro-house e trance alcançam grandes públicos. A produção digital acelera tendências e colaborações."
    },
    "2011": {
        "description": "A EDM ganha força internacional, com grandes festivais e produções de impacto voltadas para multidões. Progressive house, electro-house e vocal dance dominam muitos palcos, enquanto a internet aproxima artistas, DJs e fãs de diferentes países."
    },
    "2012": {
        "description": "A EDM chega ao centro da cultura pop mundial. Grandes festivais, colaborações entre DJs e artistas pop e lançamentos digitais ampliam o alcance da música eletrônica. House, techno e trance preservam cenas próprias e continuam evoluindo nos clubes."
    },
    "2013": {
        "description": "A música eletrônica vive grande exposição comercial. EDM e dance-pop ocupam rádios, festivais e plataformas digitais, enquanto deep house, techno e trance conquistam públicos específicos. A circulação global de música torna-se cada vez mais rápida."
    },
    "2014": {
        "description": "A cena eletrônica se diversifica entre grandes produções de festival e estilos intimistas de clube. Deep house, tropical house, techno e EDM aparecem em diferentes espaços, enquanto o streaming transforma hábitos de escuta."
    },
    "2015": {
        "description": "O streaming muda a forma como o público encontra música, e a dance music acompanha essa transformação. Future house, tropical house, deep house e EDM circulam globalmente, enquanto a nostalgia por décadas anteriores cresce em festas, remixes e playlists."
    },
    "2016": {
        "description": "A música eletrônica combina tendências de festival com house, techno e sons melódicos. O streaming consolida-se como meio central de descoberta, e referências dos anos 1990 e 2000 reaparecem em remixes, releituras e produções contemporâneas."
    },
    "2017": {
        "description": "A dance music continua se expandindo por meio do streaming e das redes sociais. House, techno, future bass e EDM convivem com cenas locais e independentes. A nostalgia por clássicos das pistas inspira novas versões e aproxima gerações."
    },
    "2018": {
        "description": "A produção eletrônica mistura estilos, do house e techno ao EDM melódico e às sonoridades pop. Playlists e serviços de streaming fortalecem a descoberta musical, enquanto eventos e clubes mantêm viva a experiência coletiva da pista."
    },
    "2019": {
        "description": "No fim da década, a música eletrônica está mais diversa e conectada. House, techno, trance e pop eletrônico circulam globalmente, enquanto remixes, playlists e referências retrô mantêm o diálogo entre a cultura atual dos clubes e os clássicos da dance music."
    },
    "2020": {
        "description": "O fechamento de clubes e festivais durante a pandemia transforma a experiência da música de dança. DJs e artistas recorrem a transmissões online e lançamentos digitais para manter contato com o público, enquanto ouvintes revisitam clássicos e descobrem novas formas de compartilhar música."
    },
    "2021": {
        "description": "Com a retomada gradual de eventos em diferentes regiões, a música eletrônica volta aos espaços presenciais, sem abandonar as conexões digitais criadas no período anterior. House, techno, trance e sons nostálgicos seguem presentes em lançamentos, transmissões e playlists."
    },
    "2022": {
        "description": "A reabertura de clubes e festivais devolve força à experiência coletiva da pista. A música eletrônica reúne tendências atuais e referências de outras décadas, com house, techno, trance e dance-pop circulando em eventos e plataformas de streaming."
    },
    "2023": {
        "description": "A dance music atravessa gerações, combinando novas produções com o retorno de sonoridades retrô. Redes sociais e plataformas digitais impulsionam descobertas, enquanto festas temáticas e sets de DJs mantêm viva a memória da Eurodance e dos clássicos das pistas."
    },
    "2024": {
        "description": "A música eletrônica segue misturando estilos e épocas. House, techno, trance e pop dançante convivem com remixes e referências nostálgicas, enquanto streaming e redes sociais aproximam artistas e ouvintes e renovam o interesse pelos sons clássicos da pista."
    },
    "2025": {
        "description": "A cena eletrônica mantém sua diversidade global, conectando lançamentos atuais, cultura de festivais e redescoberta de clássicos. A nostalgia pela Eurodance e pela dance music dos anos 1990 continua inspirando playlists, festas e novas leituras para diferentes gerações."
    }
}